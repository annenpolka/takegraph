<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TakeGraph.Ymm4Bridge</AssemblyName>
    <RootNamespace>TakeGraph.Ymm4Bridge</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Ymm4Path Condition="'$(Ymm4Path)' == '' and '$(YMM4_PATH)' != ''">$(YMM4_PATH)</Ymm4Path>
    <UseYmm4ContractStub Condition="'$(UseYmm4ContractStub)' == ''">false</UseYmm4ContractStub>
    <DefineConstants Condition="'$(UseYmm4ContractStub)' == 'true'">$(DefineConstants);TAKEGRAPH_YMM4_CONTRACT_STUB</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateYmm4ContractPath"
          BeforeTargets="PrepareForBuild"
          Condition="'$(UseYmm4ContractStub)' != 'true'">
    <Error Condition="'$(Ymm4Path)' == ''"
           Text="Ymm4Path is required. Pass -p:Ymm4Path=&lt;YMM4 directory&gt; or set YMM4_PATH." />
    <Error Condition="'$(Ymm4Path)' != '' and !Exists('$(Ymm4Path)\YukkuriMovieMaker.Plugin.dll')"
           Text="YukkuriMovieMaker.Plugin.dll was not found under Ymm4Path '$(Ymm4Path)'." />
  </Target>

  <ItemGroup Condition="'$(UseYmm4ContractStub)' != 'true' and '$(Ymm4Path)' != ''">
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>$(Ymm4Path)\YukkuriMovieMaker.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
