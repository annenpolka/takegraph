# TakeGraph connects to an already-running VOICEVOX ENGINE.
# The engine is intentionally not downloaded or redistributed by this repository.
TAKEGRAPH_VOICEVOX_ENDPOINT=http://127.0.0.1:50021

# TakeGraph-owned YMM4 bridge. The token is read from the credentials file by
# default; avoid placing the token itself in a checked-in env file.
TAKEGRAPH_YMM4_ENDPOINT=http://127.0.0.1:8766
# TAKEGRAPH_YMM4_CREDENTIALS=C:\Users\you\AppData\Local\TakeGraph\ymm4-bridge.json

# Canonical YMM4 state and operation journals. The CLI and MCP server resolve
# the same overrides, preventing split-brain stores in custom deployments.
# TAKEGRAPH_PROJECT_STATE_ROOT=C:\path\to\takegraph-project-store
# TAKEGRAPH_PROJECT_OPERATION_ROOT=C:\path\to\takegraph-project-operations

# MCP Streamable HTTP development server.
PORT=3001
